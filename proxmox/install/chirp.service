[Unit]
Description=chirp S.M.A.R.T. monitoring server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/chirp/current
EnvironmentFile=/etc/chirp/chirp.env
ExecStart=/usr/bin/node /opt/chirp/current/apps/server/dist/index.js
Restart=on-failure
RestartSec=3

# 하드닝: 디스크 조회(smartctl/nvme)에 필요한 권한만 남긴다.
ProtectSystem=strict
ReadWritePaths=/var/lib/chirp
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_SYS_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
