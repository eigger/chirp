# chirp: example environment (everything is optional). Proxmox installs use /etc/chirp/chirp.env.
# Invalid values (e.g. a non-numeric CHIRP_PORT, a too-short CHIRP_API_KEY) stop the server with a clear message.

# --- Server ---
# Integer 1-65535
CHIRP_PORT=80
# Bind address. 0.0.0.0 / :: listen everywhere (health probes then use 127.0.0.1).
CHIRP_HOST=0.0.0.0
# Optional built-in TLS (HTTPS). Both must be set (or neither). Fastify will serve HTTPS
# directly and derive CHIRP_COOKIE_SECURE=true by default.
# Note: For production setups, a reverse proxy (Caddy, nginx) or Tailscale is recommended.
# CHIRP_TLS_CERT=/etc/ssl/certs/chirp.crt
# CHIRP_TLS_KEY=/etc/ssl/private/chirp.key
# Which proxies to believe for the client address (X-Forwarded-For/-Proto):
#   false (default): the TCP peer. Behind a proxy every client then shares the proxy's address
#     (one login backoff for everybody) and the cookie gets no automatic Secure flag.
#   10.0.0.5,10.0.0.0/24,fd00::/64: the proxy's own addresses (RECOMMENDED): the headers are
#     believed only on requests that really come from the proxy.
#   1, 2, ...: the number of proxies in front of chirp. Believes the headers from ANY peer, so
#     only safe when chirp is reachable only through the proxy (CHIRP_HOST=127.0.0.1 or a firewall).
#   true: trust every X-Forwarded-For entry. Same caveat, and also unsafe unless the proxy
#     OVERWRITES that header. chirp warns when a hop count/true is used with a wildcard CHIRP_HOST.
# CHIRP_TRUST_PROXY=false
# Failed logins allowed per username per rolling 24 h before only addresses that signed in before
# may try (10-1000000, default 1000). Reset by `cli.js admin reset-password` or a restart.
# CHIRP_LOGIN_DAILY_BUDGET=1000
# Comma-separated allowed origins (default: CORS disabled)
# CHIRP_CORS_ORIGINS=https://dash.example.com
# Instance display name (default: hostname)
# CHIRP_DISPLAY_NAME=pve

# --- Admin account (dashboard login) ---
# Without these, the first visitor of the dashboard creates the admin account: do it right after installing.
# Set both to create the account on start instead (ignored once an admin exists; they never overwrite a
# changed password). Username: 1-64 of A-Z a-z 0-9 . _ @ -; password: 10-256 characters and not a
# common/guessable one (the server refuses to start otherwise).
# CHIRP_ADMIN_PASSWORD stays readable in the environment (docker inspect, compose files) after the
# account exists: remove both variables after the first start and change the password in the dashboard.
# Forgot the password? node apps/server/dist/cli.js admin reset-password
#   (the CLI also reads /etc/chirp/chirp.env, or --env-file <path> / CHIRP_ENV_FILE)
# CHIRP_ADMIN_USER=admin
# CHIRP_ADMIN_PASSWORD=
# One-time setup token for first-run registration. Generated automatically by the Proxmox
# installer and written to /etc/chirp/chirp.env (0600). When set, POST /bootstrap/admin
# requires this token. Removed automatically from the env file once the admin is created.
# CHIRP_SETUP_TOKEN=
# Session cookie Secure flag: auto (default: when the request came over HTTPS; behind a proxy this needs
# CHIRP_TRUST_PROXY to trust it), true or false.
# CHIRP_COOKIE_SECURE=auto

# --- API key (Home Assistant) ---
# CHIRP_API_KEY wins (at least 16 characters, no whitespace; read-only in the dashboard). Otherwise the
# key file (0600) is read, and created on the first start. The key is never written to the log unless
# CHIRP_PRINT_KEY=true. See and regenerate it in the dashboard (Settings -> API key), or on the server:
# node apps/server/dist/cli.js key show|rotate
# CHIRP_API_KEY=chp_...
# CHIRP_API_KEY_FILE=/var/lib/chirp/api-key
# CHIRP_PRINT_KEY=false
# Also holds admin.json (the admin account), instance-id and disk-ids.json (pinned disk IDs).
CHIRP_DATA_DIR=/var/lib/chirp

# --- Collection ---
# Comma-separated device list. /dev/disk/by-id/... paths are recommended (stable across reboots).
# Empty = discover with `smartctl --scan -j` (does not open devices) at start, every
# CHIRP_RESCAN_INTERVAL seconds and on POST /api/v1/refresh.
# CHIRP_DEVICES=/dev/sda,/dev/sdb,/dev/nvme0
# path=type pairs (RAID controllers, USB bridges, ...), e.g. /dev/sda=sat
# CHIRP_DEVICE_TYPES=/dev/sda=sat,/dev/sdb=megaraid,0   (commas inside a type are fine; values starting with "-" are ignored)
# Discovery: scan (default, never opens devices) or scan-open (opens each device to detect its type; may wake disks)
# CHIRP_SCAN_MODE=scan
# Seconds between re-discoveries (minimum 60)
# CHIRP_RESCAN_INTERVAL=3600
CHIRP_SMART_INTERVAL=300
CHIRP_SENSOR_INTERVAL=10
CHIRP_SMARTCTL=smartctl
# sysfs root for hwmon (CPU temperature, fans, voltages, hwmon power), RAPL powercap and
# sysfs disk IDs. Docker: -v /sys:/host/sys:ro with CHIRP_SYSFS_ROOT=/host/sys (one mount for
# this and CHIRP_HOST_SYS). Proxmox LXC and bare metal: /sys.
CHIRP_SYSFS_ROOT=/sys

# --- Host metrics (memory, load, network, power, fans, voltages; sampled every CHIRP_SENSOR_INTERVAL) ---
# Host /proc for memory/load. Default: /host/proc if it exists, else /proc. In an LXC the installer
# bind-mounts the host's /proc/meminfo, /proc/stat and /proc/loadavg there (read-only); in Docker mount
# the same three files (-v /proc/meminfo:/host/proc/meminfo:ro ...). Values read from the container's
# own /proc are reported as scope "container". On ZFS hosts the ARC counts as used memory.
# CHIRP_HOST_PROC=/host/proc
# Host /sys for network interfaces (/sys/class/net is per network namespace). Default: /host/sys if it
# exists, else /sys. Docker: -v /sys:/host/sys:ro
# CHIRP_HOST_SYS=/host/sys
# Network interfaces, comma-separated globs. Shown by default: physical NICs, bonds, bridges, VLANs.
# Hidden by default: lo, veth*, tap*, fwbr*, fwpr*, fwln*, docker*, br-* and other virtual devices.
# INCLUDE always shows a match; EXCLUDE always hides one (and wins over INCLUDE).
# CHIRP_NET_INCLUDE=wg0
# CHIRP_NET_EXCLUDE=enp7s0
# Temperature warning thresholds (°C)
CHIRP_TEMP_WARN_HDD=55
CHIRP_TEMP_WARN_SSD=70
CHIRP_TEMP_WARN_NVME=75

# --- Dashboard ---
# Static file directory (default: apps/web/dist). Without an index.html static serving is skipped.
# CHIRP_WEB_DIR=/opt/chirp/apps/web/dist
