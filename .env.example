# chirp — 환경 변수 예시 (모두 선택). Proxmox 설치본은 /etc/chirp/chirp.env 를 쓴다.

# --- 서버 ---
CHIRP_PORT=80
CHIRP_HOST=0.0.0.0
# 신뢰하는 역프록시 뒤에서 실행할 때만 true
# CHIRP_TRUST_PROXY=false
# 쉼표 구분 허용 Origin (기본: CORS 미사용)
# CHIRP_CORS_ORIGINS=https://dash.example.com
# 인스턴스 표시 이름 (기본: 호스트명)
# CHIRP_DISPLAY_NAME=pve

# --- API 키 ---
# CHIRP_API_KEY 가 있으면 최우선. 없으면 키 파일(0600)을 읽고, 파일도 없으면 첫 기동에 생성해 로그에 한 번 출력한다.
# CHIRP_API_KEY=chp_...
# CHIRP_API_KEY_FILE=/var/lib/chirp/api-key
CHIRP_DATA_DIR=/var/lib/chirp

# --- 수집 ---
# 쉼표 구분 장치 목록. 비우면 `smartctl --scan-open -j` 로 탐색
# CHIRP_DEVICES=/dev/sda,/dev/sdb,/dev/nvme0
# path=type 쌍 (RAID 컨트롤러/USB 브리지 등), 예: /dev/sda=sat
# CHIRP_DEVICE_TYPES=/dev/sda=sat,/dev/sdb=megaraid,0   (타입 안의 쉼표 허용; "-"로 시작하는 값은 무시)
CHIRP_SMART_INTERVAL=300
CHIRP_SENSOR_INTERVAL=10
CHIRP_SMARTCTL=smartctl
CHIRP_SYSFS_ROOT=/sys
# 온도 경고 임계값 (°C)
CHIRP_TEMP_WARN_HDD=55
CHIRP_TEMP_WARN_SSD=70
CHIRP_TEMP_WARN_NVME=75

# --- 대시보드 ---
# 정적 파일 디렉터리 (기본: apps/web/dist). index.html 이 없으면 정적 서빙을 건너뛴다.
# CHIRP_WEB_DIR=/opt/chirp/apps/web/dist
